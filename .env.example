# Public canonical HTTPS origin. Required for production canonical, Open Graph, sitemap, and robots URLs.
NEXT_PUBLIC_SITE_URL=https://explorer.example.com

# Optional trusted Qubic RPC overrides. Defaults use the public official endpoints.
# NEXT_PUBLIC_QUBIC_LIVE_RPC_URL=https://rpc.qubic.org/live/v1
# NEXT_PUBLIC_QUBIC_QUERY_RPC_URL=https://rpc.qubic.org/query/v1

# Optional Glyph wallet integration. Values are public verification keys, never private keys.
# NEXT_PUBLIC_GLYPH_DAPP_ORIGIN=https://explorer.example.com
# NEXT_PUBLIC_GLYPH_WALLET_CALLBACK_PUBLIC_KEY=
# NEXT_PUBLIC_GLYPH_WALLET_CALLBACK_PUBLIC_KEYS=

# Set true only while debugging in a browser. Events remain local and are never transmitted.
# NEXT_PUBLIC_EXPLORER_DIAGNOSTICS=false
